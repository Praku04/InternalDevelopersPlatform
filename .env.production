# Internal Developers Platform - Production Environment Configuration
# Copy this to .env and fill in the missing values

# ============================================================================
# ENVIRONMENT SETTINGS
# ============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
DEMO_MODE=false

# ============================================================================
# AWS CONFIGURATION
# ============================================================================
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514

# DynamoDB Configuration
DYNAMODB_TABLE_PREFIX=internal-dev-portal
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000

# S3 Configuration (optional - for Terraform state storage)
S3_BUCKET=internal-dev-portal-artifacts
S3_TFSTATE_BUCKET=internal-dev-portal-tfstate
DYNAMODB_LOCK_TABLE=internal-dev-portal-tfstate-lock

# ============================================================================
# AZURE DEVOPS CONFIGURATION
# ============================================================================
# Organization: https://dev.azure.com/prakashranjan0943/Internal%20Deployment%20Portal
AZDO_ORGANIZATION=prakashranjan0943
AZDO_PROJECT=Internal Deployment Portal
AZDO_REPOSITORY_ID=<NEED_TO_GET_THIS>
AZDO_PIPELINE_ID=<NEED_TO_CREATE_PIPELINE>

# Personal Access Token - YOU MUST PROVIDE THIS
# Create at: https://dev.azure.com/prakashranjan0943/_usersSettings/tokens
# Required Scopes: Build (Read & execute), Code (Read & write), Release (Read, write & execute)
AZDO_PAT=<YOUR_PERSONAL_ACCESS_TOKEN_HERE>

# ============================================================================
# GIT CONFIGURATION
# ============================================================================
GIT_REPOSITORY=https://dev.azure.com/prakashranjan0943/Internal%20Deployment%20Portal/_git/Internal%20Deployment%20Portal
GIT_BRANCH=main

# ============================================================================
# BACKEND API CONFIGURATION
# ============================================================================
# Use your VPS hostname or IP address
BACKEND_API_URL=http://corridors:8100

# ============================================================================
# TERRAFORM CONFIGURATION
# ============================================================================
TERRAFORM_MODULES_PATH=/terraform-modules

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
