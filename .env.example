# Copy to .env and fill in real values. Never commit .env.
# All values here are placeholders — actual credentials are resolved at
# runtime via IAM roles / AWS Secrets Manager / Parameter Store.

ENVIRONMENT=local
LOG_LEVEL=INFO

AWS_REGION=ap-south-1

# Bedrock model is configurable so it can be swapped without code changes.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514

DYNAMODB_TABLE_PREFIX=ai-cloud-self-service
DYNAMODB_ENDPOINT_URL=http://localhost:8001

# S3 Configuration
S3_BUCKET=ai-cloud-platform-artifacts
S3_TFSTATE_BUCKET=ai-cloud-platform-tfstate
DYNAMODB_LOCK_TABLE=ai-cloud-platform-tfstate-lock

# Azure DevOps Configuration
# Organization: dev.azure.com/<ORGANIZATION>
AZDO_ORGANIZATION=your-org
AZDO_PROJECT=AI-Cloud-Self-Service
AZDO_REPOSITORY_ID=your-repo-id
AZDO_PIPELINE_ID=1
# PAT should be loaded from AWS Secrets Manager in production
AZDO_PAT=

# Git Configuration
GIT_REPOSITORY=https://dev.azure.com/your-org/AI-Cloud-Self-Service/_git/ai-cloud-platform
GIT_BRANCH=main

# Backend API URL (for pipeline callbacks)
BACKEND_API_URL=http://localhost:8100

TERRAFORM_MODULES_PATH=../terraform/modules

# Demo/mock mode must stay explicit. Set to false only once real AWS
# integration is wired up — never fake a deployment result silently.
DEMO_MODE=true

NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
